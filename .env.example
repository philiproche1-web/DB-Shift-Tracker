VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web Push public VAPID key (from `npx web-push generate-vapid-keys`).
# Vite inlines this at build time, so the app must be rebuilt and redeployed
# after setting it — see docs/superpowers/plans/2026-08-13-web-push-runbook.md.
VITE_VAPID_PUBLIC_KEY=
# PostHog project API key (Project Settings -> API Keys, "Project API key").
# Missing = analytics silently disabled, app still works.
VITE_POSTHOG_KEY=
# Optional — defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com
# if the PostHog project region is EU.
VITE_POSTHOG_HOST=
